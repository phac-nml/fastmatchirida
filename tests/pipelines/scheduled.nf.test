    test("Multiple - No Prefix, No Date - 1 Top Sample") {
        tag "pipeline_scheduled"
        tag "pipeline_scheduled_multiple_no_prefix_no_date_top_samples_1"

        when {
            params {
                input = "$baseDir/tests/data/samplesheets/scheduled_multiple.csv"
                outdir = "results"

                output_type = "scheduled"

                pd_distm = "hamming"
                threshold = 10
                fastmatch_top_samples_threshold = 1

                output_prefix = ""
                prefix_include_date = false

                metadata_1_header = "genomic_address_name"
                metadata_2_header = "national_outbreak_code"
            }
        }

        then {
            assert workflow.success

            // Check Files Exist
