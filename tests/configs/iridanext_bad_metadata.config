iridanext {
    enabled = true
    output {
        path = "${params.outdir}/iridanext.output.json"
        overwrite = true
        schema = "${projectDir}/output_schema.json"
        validate = true
        files {
            idkey = "irida_id"
            global = [
                "**/process/*fastmatch.xlsx"
            ]
        }
        metadata {
            samples {
                keep = [
                    "fastmatch_status",
                    "fastmatch_top_samples",
                    "fastmatch_matched_samples_count",
                    "fastmatch_threshold",
                    "fastmatch_date",
                    "fastmatch_code_match",
                    "fastmatch_top_genomic_address",
                    "fastmatch_results_filename"
                ]
                rename = ["fastmatch_status": "fastmatch_status_bad"]
                csv {
                    path = "**/process/*fastmatch.scheduled.tsv"
                    sep = "\t"
                    idcol = 'query_id'
                }
            }
        }
    }
}
