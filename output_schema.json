{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/phac-nml/nf-iridanext/main/plugins/nf-iridanext/src/resources/nextflow/iridanext/output_schema.json",
  "title": "Default IRIDA Next JSON output schema",
  "description": "Default schema used for validating IRIDA Next JSON output data",
  "type": "object",
  "properties": {
    "files": {
      "type": "object",
      "properties": {
        "global": {
          "type": "array"
        },
        "samples": {
          "type": "object"
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "samples": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "properties": {
                "fastmatch_status": {
                  "type": "string"
                },
                "fastmatch_top_samples": {
                  "type": "string"
                },
                "fastmatch_matched_samples_count": {
                  "type": "string"
                },
                "fastmatch_threshold": {
                  "type": "string"
                },
                "fastmatch_date": {
                  "type": "string"
                },
                "fastmatch_code_match": {
                  "type": "string"
                },
                "fastmatch_top_genomic_address": {
                  "type": "string"
                },
                "fastmatch_results_filename": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "fastmatch_status",
                "fastmatch_top_samples",
                "fastmatch_matched_samples_count",
                "fastmatch_threshold",
                "fastmatch_date",
                "fastmatch_code_match",
                "fastmatch_top_genomic_address",
                "fastmatch_results_filename"
              ]
            }
          }
        }
      }
    }
  }
}